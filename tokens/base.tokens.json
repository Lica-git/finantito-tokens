    "breakpoint": {
      "md": {
        "$type": "dimension",
        "$value": "800px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1100px"
      }
    },
    "font": {
      "ui": {
        "$type": "fontFamily",
        "$value": [
          "Satoshi",
          "Plus Jakarta Sans",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "kicker": {
        "$type": "fontFamily",
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    },
    "type": {
      "balance": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{esk.font.ui}",
          "fontSize": "46px",
          "fontWeight": 500,
          "lineHeight": 1,
          "letterSpacing": "-0.045em"
        },
        "$description": "66px a partir de 800px"
      },
      "amount": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{esk.font.ui}",
          "fontSize": "42px",
          "fontWeight": 500,
          "lineHeight": 1,
          "letterSpacing": "-0.045em"
        }
      },
      "screen-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{esk.font.ui}",
          "fontSize": "29px",
          "fontWeight": 500,
          "lineHeight": "36px",
          "letterSpacing": "-0.03em"
        }
      },
      "sheet-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{esk.font.ui}",
          "fontSize": "22px",
          "fontWeight": 500,
          "lineHeight": "28px",
          "letterSpacing": "-0.02em"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{esk.font.ui}",
          "fontSize": "16px",
          "fontWeight": 500,
          "lineHeight": "22px",
          "letterSpacing": "0em"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{esk.font.ui}",
          "fontSize": "13px",
          "fontWeight": 500,
          "lineHeight": "18px",
          "letterSpacing": "0em"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{esk.font.ui}",
          "fontSize": "12px",
          "fontWeight": 400,
          "lineHeight": "16px",
          "letterSpacing": "0em"
        }
      },
      "kicker": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{esk.font.kicker}",
          "fontSize": "11px",
          "fontWeight": 400,
          "lineHeight": "16px",
          "letterSpacing": "0.08em"
        },
        "$description": "uppercase"
      }
    }
  }
