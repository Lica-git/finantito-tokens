        "$value": "32px"
      },
      "card": {
        "$type": "dimension",
        "$value": "34px"
      },
      "sheet": {
        "$type": "dimension",
        "$value": "34px"
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px"
      }
    },
    "space": {
      "4": {
        "$type": "dimension",
        "$value": "4px"
      },
      "8": {
        "$type": "dimension",
        "$value": "8px"
      },
      "12": {
        "$type": "dimension",
        "$value": "12px"
      },
      "16": {
        "$type": "dimension",
        "$value": "16px"
      },
      "20": {
        "$type": "dimension",
        "$value": "20px"
      },
      "24": {
        "$type": "dimension",
        "$value": "24px"
      },
      "32": {
        "$type": "dimension",
        "$value": "32px"
      },
      "40": {
        "$type": "dimension",
        "$value": "40px"
      },
      "48": {
        "$type": "dimension",
        "$value": "48px"
      },
      "64": {
        "$type": "dimension",
        "$value": "64px"
      }
